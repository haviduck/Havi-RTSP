{
  "name": "havi-rtsp",
  "version": "1.0.0",
  "description": "Play RTSP H.264/H.265 in a browser by remuxing RTP to fMP4.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "bin": {
    "havi-rtsp": "./bin/havi-rtsp.js",
    "havi-remux": "./bin/havi-remux.js",
    "havi-pipe": "./bin/havi-pipe.js"
  },
  "browser": "./dist/havi-rtsp.browser.mjs",
  "files": [
    "bin",
    "src",
    "dist",
    "public",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/havi-rtsp.js",
    "remux": "node bin/havi-remux.js",
    "pipe": "node bin/havi-pipe.js",
    "build:browser": "node scripts/build-browser.mjs",
    "build:host": "deno compile --allow-net --allow-read --include dist/havi-rtsp.browser.js --output dist/havi-rtsp-host.exe dist/havi-rtsp.browser.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "rtsp",
    "rtp",
    "h264",
    "h265",
    "hevc",
    "mse",
    "fmp4"
  ],
  "author": "Carl Martin Haug",
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "buffer": "^6.0.3",
    "esbuild": "^0.25.0"
  }
}
